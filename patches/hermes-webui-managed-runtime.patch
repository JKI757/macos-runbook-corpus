+def _activate_managed_agent_runtime(python_exe: str, agent_dir: Path | None) -> str:
+    """Use PM's interpreter AND committed packages before any third-party import.
+
+    The old agent venv is only a stdlib discovery host after PM migration.
+    Importing run_agent from it re-execs into an isolated store Python, which
+    cannot even import yaml until the selected dependency environment is added.
+    Resolve this on every launch rather than pinning a collectible generation.
+    """
+    if agent_dir is None or not (agent_dir / "pm" / "environments.py").is_file():
+        return python_exe
+    import json
+
+    script = (
+        "import sys, json\n"
+        "from pathlib import Path\n"
+        f"root = Path({str(agent_dir)!r})\n"
+        "sys.path.insert(0, str(root))\n"
+        "from hermes_cli._launchers import resolve_store_python\n"
+        "from pm.environments import activation_environment\n"
+        "python = resolve_store_python(root)\n"
+        "print(json.dumps({'python': str(python), 'env': activation_environment(root)})) "
+        "if python is not None else print('{}')\n"
+    )
+    check = subprocess.run(
+        [python_exe, "-c", script], capture_output=True, text=True,
+        env=os.environ.copy(), check=True, timeout=30,
+    )
+    runtime = json.loads(check.stdout)
+    if not runtime:
+        return python_exe
+    os.environ.update(runtime["env"])
+    # PM intentionally removes these: update() alone would retain stale values.
+    for name in ("PYTHONHOME", "VIRTUAL_ENV"):
+        os.environ.pop(name, None)
+    info(f"Using managed Hermes runtime: {runtime['python']}")
+    return runtime["python"]
+
+
